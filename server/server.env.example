# Standardpfade der v0.6-Installation. Alle Werte können überschrieben werden.
LCS_SERVER_DB=/opt/lcs-server/data/lcs.sqlite3
LCS_SESSION_TTL=120
LCS_ACTION_LEASE=180
LCS_ACTION_PREFETCH=86400
LCS_SERVER_HOST=127.0.0.1
LCS_SERVER_PORT=5000
LCS_RELEASES_DIR=/opt/lcs-server/releases
LCS_MANIFEST_FILE=/opt/lcs-server/bootstrap-manifest.json
LCS_TOKEN_FILE=/opt/lcs-server/.token
LCS_SECRET_KEY=BITTE_MIT_OPENSSL_RAND_HEX_32_ERZEUGEN
LCS_OIDC_DISCOVERY_URL=https://keycloak.example/realms/schule/.well-known/openid-configuration
LCS_OIDC_CLIENT_ID=lcs
LCS_OIDC_CLIENT_SECRET=
LCS_ADMIN_USERS=administrator,admin@example.org
LCS_MAX_REQUEST_BYTES=2097152
