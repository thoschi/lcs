[Unit]
Description=LCS Management Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVER_USER@
Group=@SERVER_USER@
WorkingDirectory=@SERVER_ROOT@
EnvironmentFile=@SERVER_ENV@
Environment=LCS_SERVER_ENV=@SERVER_ENV@
ExecStart=@SERVER_ROOT@/venv/bin/gunicorn --config @SERVER_ROOT@/gunicorn.conf.py server:app
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
